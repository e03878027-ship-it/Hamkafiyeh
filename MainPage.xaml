
<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="Hamkafiyeh.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    FlowDirection="RightToLeft"
    BackgroundColor="#F4F4F6">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="18">

                <Grid ColumnDefinitions="*,Auto" Padding="5,10">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="همکفیه"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="#D20F1D"/>

                        <Label
                            Text="به دنیای سرگرمی خوش آمدید"
                            FontSize="14"
                            TextColor="#555555"/>
                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="🎭"
                        FontSize="38"
                        VerticalOptions="Center"/>
                </Grid>

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Entry
                            x:Name="SearchInput"
                            Placeholder="چه چیزی دنبالش هستی؟"
                            FontSize="14"
                            ClearButtonVisibility="WhileEditing"
                            ReturnType="Search"
                            Completed="SearchClicked"/>

                        <Button
                            Grid.Column="1"
                            Text="جستجو"
                            BackgroundColor="#D20F1D"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="SearchClicked"/>
                    </Grid>
                </Border>

                <Label
                    Text="دسته‌بندی سرگرمی‌ها"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="#171717"/>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TheaterClicked"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Image Source="theater.jpg" HeightRequest="160" Aspect="AspectFill"/>
                        <Label Text="🎭 تئاتر" FontSize="19" FontAttributes="Bold" TextColor="#171717"/>
                        <Label Text="تماشای اجراهای جذاب و رزرو بلیت" FontSize="13" TextColor="#666666"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="HorrorClicked"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Image Source="horror.jpg" HeightRequest="160" Aspect="AspectFill"/>
                        <Label Text="👻 سینما ترس" FontSize="19" FontAttributes="Bold" TextColor="#171717"/>
                        <Label Text="تجربه هیجان و وحشت" FontSize="13" TextColor="#666666"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="EscapeClicked"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Image Source="escape.jpg" HeightRequest="160" Aspect="AspectFill"/>
                        <Label Text="🔐 اتاق فرار" FontSize="19" FontAttributes="Bold" TextColor="#171717"/>
                        <Label Text="ماجراجویی و حل معما" FontSize="13" TextColor="#666666"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="EventsClicked"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Image Source="events.jpg" HeightRequest="160" Aspect="AspectFill"/>
                        <Label Text="🎤 همایش‌ها و رویدادها" FontSize="19" FontAttributes="Bold" TextColor="#171717"/>
                        <Label Text="دورهمی‌ها و برنامه‌های ویژه" FontSize="13" TextColor="#666666"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ShopClicked"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Image Source="shop.jpg" HeightRequest="160" Aspect="AspectFill"/>
                        <Label Text="🛍 فروشگاه" FontSize="19" FontAttributes="Bold" TextColor="#171717"/>
                        <Label Text="خرید محصولات همکفیه" FontSize="13" TextColor="#666666"/>
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="همکفیه؛ تجربه‌ای متفاوت از سرگرمی"
                    FontSize="14"
                    TextColor="#777777"
                    HorizontalOptions="Center"
                    Margin="0,10,0,20"/>

            </VerticalStackLayout>
        </ScrollView>

        <Grid
            Grid.Row="1"
            BackgroundColor="White"
            Padding="5,8"
            ColumnDefinitions="*,*,*,*">

            <VerticalStackLayout Grid.Column="0" Spacing="3" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="HomeClicked"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="⌂" FontSize="23" TextColor="#D20F1D" HorizontalOptions="Center"/>
                <Label Text="خانه" FontSize="12" TextColor="#D20F1D" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SearchTabClicked"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="⌕" FontSize="23" TextColor="#555555" HorizontalOptions="Center"/>
                <Label Text="جستجو" FontSize="12" TextColor="#555555" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TicketsClicked"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="▣" FontSize="23" TextColor="#555555" HorizontalOptions="Center"/>
                <Label Text="بلیت‌های من" FontSize="12" TextColor="#555555" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" Spacing="3" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AccountClicked"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="●" FontSize="23" TextColor="#555555" HorizontalOptions="Center"/>
                <Label Text="حساب من" FontSize="12" TextColor="#555555" HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>
